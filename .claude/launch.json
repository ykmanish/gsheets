{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reports",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", "reports", "-p", "4178", "-c-1"],
      "port": 4178
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/server.js"],
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
